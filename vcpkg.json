{
  "name": "codelenses",
  "version-string": "0.1.0",
  "description": "Local-first code indexer and browser with C++20 backend",
  "homepage": "https://github.com/slava/codelenses",
  "dependencies": [
    {
      "name": "cpp-httplib",
      "features": [
        "openssl"
      ]
    },
    {
      "name": "sqlite3",
      "features": [
        "fts5",
        "json1",
        "rtree"
      ]
    },
    "tree-sitter",
    "nlohmann-json",
    "catch2"
  ]
}
